# .env 로 복사해서 사용 (값이 없으면 app/core/config.py 기본값)
# 아래 DB 값은 개발 전용. 운영 서버에서는 반드시 다른 값을 넣는다
ENVIRONMENT=local
FRONTEND_HOST=http://localhost:3001
TIMEZONE=Asia/Seoul

# compose 가 mysql 컨테이너를 만들 때 쓰는 값
DB_NAME=fastapi
DB_USER=admin
DB_PASSWORD=admin
DB_ROOT_PASSWORD=root

# 로컬 방식(uv run fastapi dev)용. 도커에서는 compose 가 mysql:3306 으로 덮어쓴다
DATABASE_URL=mysql+aiomysql://admin:admin@127.0.0.1:3306/fastapi?charset=utf8mb4
